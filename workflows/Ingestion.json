      "name": "Split Out"
    },
    {
      "parameters": {
        "jsCode": "const graphStatement = `\nMERGE (r:Recipe {id: $id}) SET r.name = $name, r.source = $source\nMERGE (cat:Category {name: $category}) MERGE (r)-[:IN_CATEGORY]->(cat)\nMERGE (cu:Cuisine {name: $cuisine}) MERGE (r)-[:FROM_CUISINE]->(cu)\nWITH r\nUNWIND $ingredients AS ing\nMERGE (i:Ingredient {name: ing.name})\nMERGE (r)-[h:HAS_INGREDIENT]->(i) SET h.measure = ing.measure\nWITH DISTINCT r\nUNWIND $tags AS t\nMERGE (tag:Tag {name: t}) MERGE (r)-[:HAS_TAG]->(tag)`;\n\nreturn $input.all().map(item => {\n  const m = item.json;\n  const ingredients = [];\n  for (let i = 1; i <= 20; i++) {\n    const name = (m[`strIngredient${i}`] || '').trim().toLowerCase();\n    const measure = (m[`strMeasure${i}`] || '').trim();\n    if (name) ingredients.push({ name, measure });\n  }\n  const tags = (m.strTags || '').split(',').map(t => t.trim().toLowerCase()).filter(Boolean);\n  const data = {\n    id: m.idMeal,\n    name: m.strMeal || 'Unknown',\n    category: m.strCategory || 'Unknown',\n          cuisine: m.strArea || m.strCountry || 'Unknown',\n    tags,\n    ingredients,\n    source: `https://www.themealdb.com/meal/${m.idMeal}`,\n  };\n  const text = `${data.name}. ${data.category} dish from ${data.cuisine} cuisine. ` +\n               `Ingredients: ${ingredients.map(i => i.name).join(', ')}. ` +\n               `Instructions: ${m.strInstructions || ''}`;\n  return { json: { ...data, text, graphBody: { statement: graphStatement, parameters: data } } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
